# Copy this file to .env and fill in your own keys. Never commit .env.

# VirusTotal public API v3 key (free tier: 4 req/min, 500 req/day, non-commercial use only)
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# URLhaus (abuse.ch) Auth-Key (free, register at https://auth.abuse.ch/)
URLHAUS_AUTH_KEY=

# Path to the SQLite TI cache database (created automatically if missing)
TI_CACHE_DB=ti_cache.sqlite3
